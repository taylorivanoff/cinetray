{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CineTray",
  "version": "1.0.18",
  "identifier": "io.github.taylorivanoff.cinetray",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CineTray",
        "width": 1087,
        "height": 706,
        "minWidth": 1087,
        "minHeight": 706,
        "resizable": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../sidecar/host.mjs",
      "../sidecar/fs-store.js",
      "../main/watcher.js",
      "../main/renamer.js",
      "../main/parser.js",
      "../main/tmdb.js",
      "../main/manual-run.js",
      "../main/file-ready.js",
      "../main/structure-checker.js",
      "../main/logger.js"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
