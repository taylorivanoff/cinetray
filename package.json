{
  "name": "media-renamer-tray",
  "description": "System tray app that renames TV and movie files automatically using TMDB.",
  "author": {
    "name": "Taylor Ivanoff"
  },
  "version": "1.0.9",
  "repository": "https://github.com/taylorivanoff/tidy-tray",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "bump": "node scripts/bump-version.js",
    "clean:release": "node -e \"const fs=require('fs'); for (const d of ['dist/win-unpacked','dist/mac','dist/mac-arm64','dist/linux-unpacked']) { try { fs.rmSync(d,{recursive:true}); } catch (e) { if (e.code!=='ENOENT'&&e.code!=='EPERM'&&e.code!=='EBUSY') throw e; } }\"",
    "release": "npm run build && npm run clean:release && electron-builder --publish=never"
  },
  "build": {
    "appId": "io.github.taylorivanoff.media-renamer-tray",
    "productName": "Tidy Tray",
    "files": [
      "dist/**/*",
      "resources/**/*",
      "src/renderer/**/*",
      "package.json",
      "installer.nsh"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "include": "installer.nsh"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "afterPack": "./scripts/after-pack.js"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/node": "^20.19.43",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "typescript": "^5.9.3"
  }
}
